APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LCCMS (see config/lccms.php for defaults and meaning)
LCCMS_OFFLINE_SESSION_HOURS=72
LCCMS_DEVICE_TOKEN_DAYS=30
LCCMS_SYNC_MAX_BATCH=100
LCCMS_SYNC_MAX_PAYLOAD_KB=512
LCCMS_MAX_DEVICES_PER_USER=3
LCCMS_IMAGE_MAX_KB=5120
LCCMS_IMAGE_MAX_PIXELS=40000000
LCCMS_IMAGE_MAX_DIMENSION=2400
LCCMS_EXPORT_RETENTION_DAYS=7
# Use a tile provider whose terms allow your traffic; OSM public tiles are for light use only.
LCCMS_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
LCCMS_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
LCCMS_MAP_MAX_ZOOM=19
LCCMS_STRONG_AUTHENTICATION=false
